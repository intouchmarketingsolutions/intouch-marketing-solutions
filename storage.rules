rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Resumes — anyone can upload (via career form), only admin can read
    match /resumes/{fileName} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Client logos — only admin
    match /clients/logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
